# FUNCTIONS

def create_morale(day, state):
    for i in morale_phases:
        first, last, mean = morale_phases[i]

        if first <= day <= last: # The phase of this day is found
            if state == "sickness":
                mean = mean - 1.5
            elif state == "healing":
                mean = mean - 0.5

            value = round(random.gauss(mean, 0.5))
            if value < 1:
                value = 1
            elif value > 5:
                value = 5
            return value

def create(environment, state, day):
    s_day = {"Environment": environment}
    for i in states[environment][state]:
        mean, sd, digits = states[environment][state][i]
        value = random.gauss(mean, sd)
        if i == "Test Accuracy" and value > 100:
            value = 100 # Accuracy cannot be more than 100 percent
        if digits == 0:
            s_day[i] = round(value)
        else:
            s_day[i] = round(value, digits)

    s_day["State of Morale"] = create_morale(day, state)
    return s_day



def control(day,limits):
    result = {}
    caution_count = 0
    critical_count = 0
    env_limits = limits[day["Environment"]]

    for i in env_limits:
        n_low, n_high, c_low, c_high = env_limits[i]
        value = day[i]

        if i == "Exercise Time" and day["Surface Walk"]:
            result[i] = "Normal" # A surface walk is hard physical work, so exercise is not checked
        elif n_low <= value <= n_high:
            result[i] = "Normal"
        elif c_low <= value <= c_high:
            result[i] = "Caution"
            caution_count += 1
        else:
            result[i] = "Critical"
            critical_count += 1

    result["State of Morale"] = day["State of Morale"]
    result["Counts"] = [caution_count, critical_count]
    return result



def focus_pattern(result): # The two focus test results are read together
    speed = result["Reaction Time"]
    accuracy = result["Test Accuracy"]

    if speed == "Normal" and accuracy == "Normal":
        return "good"
    elif speed == "Normal" and accuracy != "Normal":
        return "rushing"
    elif speed != "Normal" and accuracy == "Normal":
        return "tired"
    else:
        return "fatigue"



def message(day,limits):
    to_Astronaut = []
    to_Earth = []
    data = All_Days[day - 1]  # The values of this day
    result = All_Days_Controlled[day - 1]  # The results of this day

    # Habits
    if day >= 5: # There must be 5 days of data
        for i in habits:
            score = 0
            low = 0
            high = 0
            for j in range(day - 5, day): # The last 5 days
                status = All_Days_Controlled[j][i]
                if status == "Caution":
                    score += 1
                elif status == "Critical":
                    score += 2

                if status != "Normal": # Was the value too low or too high?
                    n_low = limits[All_Days[j]["Environment"]][i][0]
                    if All_Days[j][i] < n_low:
                        low += 1
                    else:
                        high += 1

            if score >= 3 and day - last_warning[i] >= 5: # Wait 5 days after a warning
                if low >= high:
                    direction = "low"
                else:
                    direction = "high"
                to_Astronaut.append(advice[i][direction])
                last_warning[i] = day

    # Focus test
    pattern = All_Days_Focus[day - 1]
    to_Astronaut.append(focus_messages[pattern]["Astronaut"])
    if pattern == "fatigue": # Only a serious focus problem is sent to Earth
        to_Earth.append("DAY {} | {}".format(day, focus_messages[pattern]["Earth"]))

    # Body values and morale evaluation
    body_caution = 0
    body_critical = 0
    for i in body_values:
        if result[i] == "Caution":
            body_caution += 1
        elif result[i] == "Critical":
            body_critical += 1

    if (body_caution >= 2 or body_critical >= 1) and data["State of Morale"] <= 2:
        to_Earth.append("Body values are not normal ({} caution, {} critical) and morale is {}/5. The astronaut is probably sick.".format(
                body_caution, body_critical, data["State of Morale"]))

    return {"Astronaut": to_Astronaut, "Earth": to_Earth}


# PROGRAM

for day in range(1, 61): # Mission is scaled to 60 days for better understanding purposes.
    # Where is the astronaut?
    if day <= 15 or day >= 46:
        environment = "ISS"
    else:
        environment = "Mars"

    # How is the astronaut?
    if 12 <= day <= 17:
        state = "sickness"
    elif 18 <= day <= 21:
        state = "healing"
    else:
        state = "normal"

    # Is there a surface walk today?
    if environment == "Mars" and state == "normal" and day % 3 == 0:
        surface_walk = True # Every 3rd day on Mars and only when the astronaut is healthy
    else:
        surface_walk = False

    s_day = create(environment, state, day)
    s_day["Surface Walk"] = surface_walk
    if surface_walk:
        s_day["Exercise Time"] = 0 # The astronaut is tired for a normal exercise session after a surface walk
    All_Days.append(s_day)

for i in range(len(All_Days)):
    result = control(All_Days[i], expected_limits)
    All_Days_Controlled.append(result)
    All_Days_Focus.append(focus_pattern(result))
    All_Days_Messages.append(message(i + 1, expected_limits))

